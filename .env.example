APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ARTISAN_PHP_BINARY=php

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
COMPANY_PARSER_QUEUE=company-parser
COMPANY_PARSER_PROVIDER=overpass
COMPANY_PARSER_LIMIT=50
COMPANY_PARSER_GOOGLE_ENDPOINT=https://places.googleapis.com/v1/places:searchText
COMPANY_PARSER_GOOGLE_API_KEY=
COMPANY_PARSER_GOOGLE_FIELD_MASK=places.id,places.displayName,places.formattedAddress,places.websiteUri,places.nationalPhoneNumber,places.internationalPhoneNumber,places.location,places.googleMapsUri,nextPageToken
COMPANY_PARSER_GOOGLE_LANGUAGE_CODE=ru
COMPANY_PARSER_GOOGLE_TIMEOUT=15
COMPANY_PARSER_GOOGLE_VERIFY=true
COMPANY_PARSER_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
COMPANY_PARSER_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://lz4.overpass-api.de/api/interpreter
COMPANY_PARSER_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
COMPANY_PARSER_NOMINATIM_LOOKUP_ENDPOINT=https://nominatim.openstreetmap.org/lookup
COMPANY_PARSER_OVERPASS_TIMEOUT=12
COMPANY_PARSER_OVERPASS_RADIUS_METERS=10000
COMPANY_PARSER_OVERPASS_FALLBACK_RADIUS_METERS=5000
COMPANY_PARSER_OVERPASS_FINAL_RADIUS_METERS=2500
COMPANY_PARSER_OVERPASS_MAX_ATTEMPTS=4
COMPANY_PARSER_OVERPASS_LOOKUP_BATCH_SIZE=20
COMPANY_PARSER_OVERPASS_RETRY_SLEEP_MILLISECONDS=750
COMPANY_PARSER_OVERPASS_USER_AGENT="Mobux Company Parser/1.0"
COMPANY_PARSER_OVERPASS_VERIFY=true
COMPANY_PARSER_YANDEX_ENDPOINT=https://search-maps.yandex.ru/v1/
COMPANY_PARSER_YANDEX_API_KEY=
COMPANY_PARSER_YANDEX_LANG=ru_RU
COMPANY_PARSER_YANDEX_TIMEOUT=15
COMPANY_PARSER_YANDEX_VERIFY=true
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_MAILING_DELAY_SECONDS=1

PERFLUENCE_PROMOCODE_API_URL=https://dash.perfluence.net/blogger/promocode-api/json
PERFLUENCE_PROMOCODE_API_KEY=
